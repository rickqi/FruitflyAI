diff --git a/src/pc/fly64_bridge.c b/src/pc/fly64_bridge.c
new file mode 100644
index 0000000..5a771b5
--- /dev/null
+++ b/src/pc/fly64_bridge.c
@@ -0,0 +1,165 @@
+#include "fly64_bridge.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifdef OSX_BUILD
+#define GLEW_STATIC
+#include <GL/glew.h>
+#include <SDL2/SDL_opengl.h>
+#endif
+
+#define FLY64_WIDTH 384
+#define FLY64_HEIGHT 256
+#define FLY64_FRAME_BYTES (FLY64_WIDTH * FLY64_HEIGHT * 3)
+#define FLY64_HEADER_BYTES 128
+#define FLY64_FILE_BYTES (FLY64_HEADER_BYTES + FLY64_FRAME_BYTES)
+#define FLY64_STALE_NS 250000000ULL
+
+#pragma pack(push, 1)
+struct Fly64Header {
+    char magic[8];
+    uint32_t version;
+    volatile uint32_t frame_seq;
+    volatile uint32_t control_seq;
+    volatile uint32_t enabled;
+    volatile uint64_t heartbeat_ns;
+    volatile int8_t stick_x;
+    volatile int8_t stick_y;
+    volatile uint16_t buttons;
+    uint32_t reserved;
+    volatile uint32_t applied_seq;
+    volatile int8_t applied_x, applied_y;
+    volatile uint16_t applied_buttons;
+    volatile uint64_t game_clock_ns;
+    volatile uint32_t game_status;
+    uint32_t padding;
+    float pose[4]; /* eye x/y/z and body yaw radians; same seqlock as RGB */
+    uint32_t game_frame;
+    float render_ms;
+    uint8_t extension[40];
+};
+struct Fly64Shared {
+    struct Fly64Header h;
+    uint8_t rgb[FLY64_FRAME_BYTES];
+};
+#pragma pack(pop)
+
+static struct Fly64Shared *shared;
+static int bridge_fd = -1;
+static int body_control;
+static unsigned jump_frames;
+static uint32_t last_jump_event;
+
+static uint64_t monotonic_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+static int bridge_open(void) {
+    const char *path;
+    struct stat st;
+    if (shared != NULL) return 1;
+    path = getenv("FLY64_BRIDGE");
+    if (path == NULL || path[0] == '\0') return 0;
+    bridge_fd = open(path, O_RDWR);
+    if (bridge_fd < 0) return 0;
+    if (fstat(bridge_fd, &st) || st.st_size != FLY64_FILE_BYTES) {
+        close(bridge_fd); bridge_fd = -1; return 0;
+    }
+    shared = mmap(NULL, FLY64_FILE_BYTES, PROT_READ | PROT_WRITE, MAP_SHARED, bridge_fd, 0);
+    if (shared == MAP_FAILED) {
+        shared = NULL;
+        close(bridge_fd);
+        bridge_fd = -1;
+        return 0;
+    }
+    if (memcmp(shared->h.magic, "FLY64V2", 7) != 0 || shared->h.version != 2) {
+        fprintf(stderr, "Fly64: incompatible shared-memory bridge\n");
+        fly64_bridge_shutdown();
+        return 0;
+    }
+    fprintf(stderr, "Fly64: bridge connected at %s\n", path);
+    return 1;
+}
+
+int fly64_bridge_connected(void) { return bridge_open(); }
+int fly64_bridge_body_control(void) { return body_control; }
+
+void fly64_bridge_toggle(void) {
+    if (!bridge_open()) return;
+    shared->h.enabled = !shared->h.enabled;
+    fprintf(stderr, "Fly64: neural control %s\n", shared->h.enabled ? "enabled" : "disabled");
+}
+
+void fly64_bridge_read_controller(OSContPad *pad) {
+    int8_t x, y;
+    uint16_t buttons;
+    uint32_t before, after;
+    uint64_t heartbeat;
+    uint32_t jump_event;
+    body_control = 0;
+    if (!bridge_open()) return;
+    shared->h.game_clock_ns = monotonic_ns();
+    shared->h.applied_x = 0; shared->h.applied_y = 0; shared->h.applied_buttons = 0;
+    shared->h.game_status = 0;
+    if (!shared->h.enabled) { jump_frames = 0; return; }
+    /* Bounded seqlock read: never hang the game on a dead writer. */
+    {
+        before = __atomic_load_n(&shared->h.control_seq, __ATOMIC_ACQUIRE);
+        if (before & 1U) { shared->h.game_status = 3; return; }
+        heartbeat = shared->h.heartbeat_ns;
+        x = shared->h.stick_x;
+        y = shared->h.stick_y;
+        buttons = shared->h.buttons;
+        jump_event = shared->h.reserved;
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        after = __atomic_load_n(&shared->h.control_seq, __ATOMIC_ACQUIRE);
+        if (before != after || (after & 1U)) { shared->h.game_status = 3; return; }
+    }
+    if (monotonic_ns() - heartbeat > FLY64_STALE_NS) { jump_frames = 0; shared->h.game_status = 2; return; }
+    if (jump_event != last_jump_event) { jump_frames = 2; last_jump_event = jump_event; }
+    buttons &= ~A_BUTTON;
+    if (jump_frames) { buttons |= A_BUTTON; --jump_frames; }
+    /* Human stick input wins as a complete vector, retaining stock semantics. */
+    if (abs(pad->stick_x) < 8 && abs(pad->stick_y) < 8) {
+        pad->stick_x = x; pad->stick_y = y; body_control = 1;
+    }
+    pad->button |= buttons;
+    shared->h.applied_x = pad->stick_x; shared->h.applied_y = pad->stick_y;
+    shared->h.applied_buttons = pad->button;
+    shared->h.applied_seq = after;
+    shared->h.game_status = 1;
+}
+
+void fly64_bridge_publish_frame(const unsigned char *rgb, const float *pose, unsigned game_frame, float render_ms) {
+    uint32_t seq;
+    if (!bridge_open()) return;
+    seq = shared->h.frame_seq;
+    __atomic_store_n(&shared->h.frame_seq, seq | 1U, __ATOMIC_SEQ_CST);
+    memcpy(shared->rgb, rgb, FLY64_FRAME_BYTES);
+    memcpy(shared->h.pose, pose, sizeof(shared->h.pose));
+    shared->h.game_frame = game_frame;
+    shared->h.render_ms = render_ms;
+    __atomic_store_n(&shared->h.frame_seq, ((seq | 1U) + 1U), __ATOMIC_RELEASE);
+}
+
+void fly64_bridge_shutdown(void) {
+    if (shared != NULL) {
+        munmap(shared, FLY64_FILE_BYTES);
+        shared = NULL;
+    }
+    if (bridge_fd >= 0) {
+        close(bridge_fd);
+        bridge_fd = -1;
+    }
+}
